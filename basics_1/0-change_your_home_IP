#!/usr/bin/env bash
# Configure localhost and facebook.com mappings in /etc/hosts.
set -e
hosts_file=/etc/hosts

if [ "$EUID" -ne 0 ]; then
    printf "Run this script as root.\n" >&2
    exit 1
fi

if grep -Eq "^[[:space:]]*127\.0\.0\.2[[:space:]]+localhost([[:space:]]|$)" "$hosts_file"; then
    :
elif grep -Eq "^[[:space:]]*127\.0\.0\.1[[:space:]]+localhost([[:space:]]|$)" "$hosts_file"; then
    sed -i -E "/^[[:space:]]*127\.0\.0\.1[[:space:]]+localhost([[:space:]]|$)/ s/127\.0\.0\.1/127.0.0.2/" "$hosts_file"
else
    printf "127.0.0.2 localhost\n" >> "$hosts_file"
fi

sed -i -E "/(^|[[:space:]])facebook\.com([[:space:]]|$)/d" "$hosts_file"
printf "8.8.8.8 facebook.com\n" >> "$hosts_file"
